# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site, used for canonical URLs, sitemap and Stripe redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL (Project Settings → Data API), e.g. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (Project Settings → API Keys, starts sb_publishable_; a legacy anon key also works). Safe in the browser: RLS protects data
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (starts sb_secret_; a legacy service_role key also works). Server only: bypasses RLS
SUPABASE_SECRET_KEY=
# Postgres connection string for the CLI (Connect → Session pooler URI, with your database password). Used by db:push and db:types only
SUPABASE_DB_URL=

# Stripe secret key in TEST mode (starts sk_test_)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (from `stripe listen` locally, or the dashboard endpoint in production)
STRIPE_WEBHOOK_SECRET=

# Resend API key for transactional email. Leave empty to log emails to the server console instead
RESEND_API_KEY=
# Sender address for order and status emails, on a domain verified in Resend
EMAIL_FROM="Kiln & Co. <orders@kilnandco.test>"

# Pexels API key for `npm run seed:photos` (free: https://www.pexels.com/api/). Not needed by the running app
PEXELS_API_KEY=

# Password for the seeded owner admin account (owner@kilnandco.test, full write access). Used only by `npm run seed`
SEED_OWNER_ADMIN_PASSWORD=
# Password for the read-only demo admin (demo-admin@kilnandco.test), shared publicly in the README. Used only by `npm run seed`
SEED_DEMO_ADMIN_PASSWORD=
