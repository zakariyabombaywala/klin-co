# Public URL of the site, used for canonical URLs, sitemap and Stripe redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/public key, safe in the browser because Row Level Security protects data
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key, server only (seed script, webhook, admin actions). Never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Stripe secret key in TEST mode (starts with sk_test_)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (from `stripe listen` locally, or the dashboard endpoint in production)
STRIPE_WEBHOOK_SECRET=

# Resend API key for transactional email. Leave empty to log emails to the server console instead
RESEND_API_KEY=
# Sender address for order and status emails, on a domain verified in Resend
EMAIL_FROM="Kiln & Co. <orders@kilnandco.test>"

# Password for the seeded owner admin account (full write access); used only by `npm run seed`
SEED_OWNER_ADMIN_PASSWORD=
# Password for the read-only demo admin account shown in the README; used only by `npm run seed`
SEED_DEMO_ADMIN_PASSWORD=
